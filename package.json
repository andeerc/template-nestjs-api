{
	"name": "nestjs-api-scaffold",
	"version": "1.0.0",
	"description": "NestJS API Scaffold with Fastify, PostgreSQL, Redis, and feature-first modules",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"bootstrap": "node ./scripts/bootstrap.mjs",
		"new:module": "node ./scripts/new-module.mjs",
		"build": "nest build",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"start": "nest start",
		"start:dev": "pnpm db:migrate && nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"dev:dependencies": "docker-compose up -d",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --runInBand --no-coverage",
		"test:e2e": "vitest run --run",
		"migrate:make": "node ./scripts/database/make-migration.mjs",
		"migrate:latest": "node ./scripts/database/migrate-latest.mjs",
		"migrate:rollback": "node ./scripts/database/migrate-rollback.mjs",
		"migrate:status": "node ./scripts/database/migrate-status.mjs",
		"seed:make": "node ./scripts/database/make-seed.mjs",
		"seed:run": "node ./scripts/database/seed-run.mjs",
		"seed:rollback": "node ./scripts/database/seed-rollback.mjs",
		"seed:status": "node ./scripts/database/seed-status.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"clean": "node -e \"for(const d of ['dist','coverage'])try{require('fs').rmSync(d,{recursive:true,force:true})}catch{}\"",
		"clean:all": "node -e \"for(const d of ['dist','coverage','node_modules'])try{require('fs').rmSync(d,{recursive:true,force:true})}catch{}\""
	},
	"dependencies": {
		"@casl/ability": "^6.7.3",
		"@fastify/cookie": "^11.0.2",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^9.4.0",
		"@nestjs-modules/ioredis": "^2.2.1",
		"@nestjs/bull": "^11.0.4",
		"@nestjs/common": "^11.1.16",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.16",
		"@nestjs/platform-fastify": "^11.1.11",
		"@nestjs/platform-socket.io": "^11.1.16",
		"@nestjs/schedule": "^6.1.0",
		"@nestjs/swagger": "^11.2.3",
		"@nestjs/websockets": "^11.1.16",
		"@scalar/nestjs-api-reference": "^1.1.5",
		"@socket.io/redis-adapter": "^8.3.0",
		"better-auth": "^1.3.8",
		"@nestjs/throttler": "^6.4.0",
		"bcrypt": "^6.0.0",
		"bull": "^4.16.5",
		"cache-manager": "^7.2.7",
		"class-transformer": "^0.5.1",
		"compression": "^1.8.1",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.38.0",
		"fastify": "^5.11.3",
		"ioredis": "^5.8.2",
		"joi": "^18.0.2",
		"nestjs-zod": "^5.1.1",
		"nodemailer": "^7.0.12",
		"pdf-lib": "^1.17.1",
		"pg": "^8.16.3",
		"redis": "^5.10.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.1.11",
		"@types/bcrypt": "^6.0.0",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/node": "^22.10.7",
		"@types/nodemailer": "^7.0.4",
		"@types/pg": "^8.16.0",
		"@types/supertest": "^6.0.2",
		"@vitest/coverage-v8": "^4.0.15",
		"drizzle-kit": "^0.30.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.13",
		"typescript": "^5.7.3",
		"vitest": "^4.0.15"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.0.0"
}
